# --- docker compose up (base + API) ---
# Contraseña del superusuario de la base.
POSTGRES_PASSWORD=postgres
# Contraseña del rol app_rw. La fija init.sh con ALTER ROLE y la usa la API.
APP_RW_PASSWORD=ContraseñaSuperSercreta1234

# --- API en local, sin docker (go run ./cmd/api) ---
#   export $(grep -v '^#' .env | xargs) && go run ./cmd/api
DATABASE_URL=postgresql://app_rw:ContraseñaSuperSercreta1234@127.0.0.1:5433/atuel
PORT=3333
